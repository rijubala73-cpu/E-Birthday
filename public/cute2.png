<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <!-- Cute Happy Teddy/Bunny with Heart -->
  <!-- Ears -->
  <circle cx="34" cy="28" r="12" fill="#FFE4E6" stroke="#333" stroke-width="2.5"/>
  <circle cx="34" cy="28" r="6" fill="#FF7882"/>
  <circle cx="66" cy="28" r="12" fill="#FFE4E6" stroke="#333" stroke-width="2.5"/>
  <circle cx="66" cy="28" r="6" fill="#FF7882"/>

  <!-- Head -->
  <circle cx="50" cy="46" r="24" fill="#FFF" stroke="#333" stroke-width="3"/>
  <!-- Eyes -->
  <circle cx="42" cy="42" r="3" fill="#333"/>
  <circle cx="58" cy="42" r="3" fill="#333"/>
  <circle cx="43" cy="41" r="1" fill="#FFF"/>
  <circle cx="59" cy="41" r="1" fill="#FFF"/>
  <!-- Cheeks -->
  <ellipse cx="37" cy="48" rx="4" ry="2.5" fill="#FF7882" opacity="0.6"/>
  <ellipse cx="63" cy="48" rx="4" ry="2.5" fill="#FF7882" opacity="0.6"/>
  <!-- Nose/mouth -->
  <circle cx="50" cy="47" r="2" fill="#FF7882"/>
  <path d="M 47,49 Q 50,52 53,49" fill="none" stroke="#333" stroke-width="1.5"/>

  <!-- Body -->
  <ellipse cx="50" cy="74" rx="20" ry="16" fill="#FFF" stroke="#333" stroke-width="3"/>
  
  <!-- Red Heart held in paws -->
  <path d="M 50,66 C 45,58 35,62 38,72 C 41,78 50,84 50,84 C 50,84 59,78 62,72 C 65,62 55,58 50,66 Z" fill="#FF7882" stroke="#333" stroke-width="2"/>

  <!-- Paws -->
  <circle cx="37" cy="68" r="5" fill="#FFF" stroke="#333" stroke-width="2"/>
  <circle cx="63" cy="68" r="5" fill="#FFF" stroke="#333" stroke-width="2"/>
  <!-- Feet -->
  <ellipse cx="38" cy="88" rx="6" ry="4" fill="#FFE4E6" stroke="#333" stroke-width="2"/>
  <ellipse cx="62" cy="88" rx="6" ry="4" fill="#FFE4E6" stroke="#333" stroke-width="2"/>
</svg>
