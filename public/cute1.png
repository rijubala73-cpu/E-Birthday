<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <!-- Cake plate -->
  <ellipse cx="60" cy="105" rx="50" ry="10" fill="#E2E8F0" stroke="#333" stroke-width="2"/>
  
  <!-- Cake Bottom Layer -->
  <rect x="25" y="65" width="70" height="35" rx="5" fill="#FFE4E6" stroke="#333" stroke-width="3"/>
  <!-- Layer Frosting Dripping -->
  <path d="M 25,75 C 32,82 40,75 48,82 C 56,75 64,82 72,75 C 80,82 88,75 95,82 L 95,65 L 25,65 Z" fill="#FF7882"/>
  
  <!-- Cake Top Layer -->
  <rect x="35" y="40" width="50" height="26" rx="4" fill="#FFF" stroke="#333" stroke-width="3"/>
  <path d="M 35,48 C 42,54 50,48 58,54 C 66,48 74,54 85,48 L 85,40 L 35,40 Z" fill="#FFD166"/>
  
  <!-- Cherries / Berries -->
  <circle cx="42" cy="38" r="5" fill="#E11D48" stroke="#333" stroke-width="1.5"/>
  <circle cx="60" cy="37" r="5" fill="#E11D48" stroke="#333" stroke-width="1.5"/>
  <circle cx="78" cy="38" r="5" fill="#E11D48" stroke="#333" stroke-width="1.5"/>
  
  <!-- Candle in middle -->
  <rect x="58" y="20" width="4" height="17" fill="#4EA8DE" stroke="#333" stroke-width="1.5"/>
  <!-- Flame -->
  <path d="M 60,8 C 65,14 65,18 60,20 C 55,18 55,14 60,8 Z" fill="#FF9F1C"/>
  <circle cx="60" cy="15" r="2.5" fill="#FFD166"/>
  
  <!-- Cute little hearts -->
  <path d="M 18,30 C 14,26 10,31 16,38 C 22,31 18,26 18,30 Z" fill="#FF7882"/>
  <path d="M 102,30 C 98,26 94,31 100,38 C 106,31 102,26 102,30 Z" fill="#FF7882"/>
</svg>
