<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <!-- Gift Box and Party Confetti in bottom right -->
  <!-- Confetti streamers -->
  <path d="M 20,40 Q 40,20 30,5 Q 50,30 65,15" fill="none" stroke="#FF7882" stroke-width="3" stroke-linecap="round"/>
  <path d="M 60,60 Q 75,35 90,50 Q 105,30 115,40" fill="none" stroke="#4EA8DE" stroke-width="3" stroke-linecap="round"/>
  <!-- Gift box -->
  <rect x="35" y="55" width="55" height="50" rx="6" fill="#FFD166" stroke="#333" stroke-width="3"/>
  <!-- Ribbon on box -->
  <rect x="58" y="55" width="10" height="50" fill="#FF7882" stroke="#333" stroke-width="2"/>
  <rect x="35" y="75" width="55" height="10" fill="#FF7882" stroke="#333" stroke-width="2"/>
  <!-- Bow -->
  <path d="M 63,55 C 50,40 40,50 63,55 C 76,50 66,40 63,55 Z" fill="#FF7882" stroke="#333" stroke-width="2.5"/>
  <circle cx="63" cy="55" r="4" fill="#E11D48"/>
  <!-- Stars & sparkles -->
  <circle cx="20" cy="80" r="4" fill="#06D6A0"/>
  <circle cx="100" cy="70" r="5" fill="#FF7882"/>
  <polygon points="15,25 18,31 24,32 20,36 21,42 15,39 9,42 10,36 6,32 12,31" fill="#FFD166" stroke="#333" stroke-width="1.5"/>
</svg>
