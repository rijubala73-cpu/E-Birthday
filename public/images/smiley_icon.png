<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <!-- Yellow Smiley with Party Hat / Heart Eyes -->
  <circle cx="50" cy="50" r="42" fill="#FFD166" stroke="#333" stroke-width="4"/>
  <!-- Rosy cheeks -->
  <circle cx="28" cy="56" r="8" fill="#FF7882" opacity="0.6"/>
  <circle cx="72" cy="56" r="8" fill="#FF7882" opacity="0.6"/>
  <!-- Happy Eyes (curved joyful arcs) -->
  <path d="M 28,42 Q 35,33 42,42" fill="none" stroke="#333" stroke-width="4" stroke-linecap="round"/>
  <path d="M 58,42 Q 65,33 72,42" fill="none" stroke="#333" stroke-width="4" stroke-linecap="round"/>
  <!-- Wide joyful smile with tongue -->
  <path d="M 32,56 Q 50,80 68,56 Z" fill="#333"/>
  <path d="M 40,67 Q 50,80 60,67 Z" fill="#FF7882"/>
</svg>
